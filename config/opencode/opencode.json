{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-gpu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local GPU", 
      "options": {
        "baseURL": "http://127.0.0.1:8901/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "tiel-coder": {
          "name": "tiel-coder (Tiel-Coder-35B-A3B MiniPlus)",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "interleaved": "reasoning_content",
          "variants": {
            "think": {},
            "no-think": { "chat_template_kwargs": { "enable_thinking": false } }
          }
        },
        "general-purpose-qwen3.8": {
          "name": "general-purpose-qwen3.8 (Qwen3.8-35B-A3B-Distill MiniPlus)",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "interleaved": "reasoning_content",
          "variants": {
            "think": {},
            "no-think": { "chat_template_kwargs": { "enable_thinking": false } }
          }
        },
        "fast": {
          "name": "fast (tiel-coder NanoPlus)",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "interleaved": "reasoning_content",
          "variants": {
            "think": {},
            "no-think": { "chat_template_kwargs": { "enable_thinking": false } }
          }
        }
      }
    },
    "no-titlegen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Intentionally unreachable (kills title-gen GPU contention)",
      "options": { "baseURL": "http://127.0.0.1:8999/v1", "apiKey": "not-needed" },
      "models": { "x": { "name": "unreachable" } }
    }
  },
  "model": "local-gpu/fast",
  "small_model": "no-titlegen/x"
}
